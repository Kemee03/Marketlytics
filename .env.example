# Local PostgreSQL connection used by both Docker Compose and the Python loader.
PGHOST=localhost
PGPORT=5432
PGDATABASE=marketlytics
PGUSER=marketlytics
PGPASSWORD=replace_with_a_private_local_password
POSTGRES_PORT=5432

# Alternatively, set DATABASE_URL and remove/comment the PG* values above.
# URL-encode special characters in the password when using DATABASE_URL.
# DATABASE_URL=postgresql+psycopg2://marketlytics:encoded_password@localhost:5432/marketlytics
